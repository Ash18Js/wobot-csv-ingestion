# Copy to .env for local (non-Docker) runs. docker-compose.yml sets these itself.
DATABASE_URL=postgres://catalog:catalog@localhost:5432/catalog
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# 32+ chars. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Where uploaded CSVs are staged on disk before ingest.
UPLOAD_DIR=./uploads

# Ingest tuning
INGEST_BATCH_ROWS=20000
MAX_UPLOAD_BYTES=3221225472
LEASE_SECONDS=30
